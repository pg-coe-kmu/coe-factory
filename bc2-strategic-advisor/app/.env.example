# ---- BC2 Trigger-Endpunkt · Konfiguration ----
#
# Diese Datei ist die Vorlage. Die echte `.env` liegt NUR auf dem Server und
# NIEMALS im Repo — Zugangsdaten gehoeren ausschliesslich in
# Umgebungsvariablen (ADR-003, BC0-Regel 5).

# Gemeinsame PostgreSQL bei Supabase, Rolle bc2_role.
# WICHTIG: Session-Pooler Port 5432, nicht 6543 — der Transaction-Pooler haelt
# keine Sitzung ueber die Anweisung hinaus.
# DATABASE_URL=postgresql://bc2_role.PROJEKTKENNUNG:[PASSWORT]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Der Schluessel, den BC2 an BC0 ausstellt. BC2 ist Betreiber des Endpunkts und
# stellt darum aus — der Aufrufer bekommt ihn, nicht umgekehrt (#190).
# Erzeugen:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Uebergabe an Simeon per SMS. Nicht ueber Repo, Issue oder Chat.
# BC2_TRIGGER_TOKEN=

# Domain fuer Caddy. Leer/unset -> ":80", also nur HTTP.
# DOMAIN=bc2.02da.de
