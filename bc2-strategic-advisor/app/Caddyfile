# Reverse-Proxy mit automatischem HTTPS, sobald eine echte Domain gesetzt ist.
# DOMAIN kommt aus der .env:
#   DOMAIN=:80             -> nur HTTP (Test / nackte IP)
#   DOMAIN=bc2.02da.de     -> automatisches Let's-Encrypt-HTTPS
{$DOMAIN} {
    encode gzip

    # Der Anstoss von BC0 ist eine Handvoll IDs. Alles darueber ist ein Fehler
    # oder ein Angriff — beides soll Caddy abschneiden, bevor die Anwendung
    # Speicher dafuer belegt.
    request_body {
        max_size 64KB
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"

        # Der Server nennt seinen Namen nicht.
        -Server
    }

    # Fuer die JSON-API: alles zu. Seit die Gate-1-Oberflaeche unter `/` liegt
    # (#243, ausgerollt mit #290), bringt die Seite ihre eigene, engere Policy
    # mit (oberflaeche.seiten_csp: ihr eines Skript per Hash). Das `?` setzt den
    # Kopf nur, wenn die Anwendung keinen geschickt hat — vorher blockierte er
    # das Skript der Seite, und sie blieb bei "wird geladen" stehen.
    header ?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

    # Zugriffsprotokoll. Caddy maskiert `Authorization` von sich aus — genau
    # deshalb steht der Schluessel dort und nicht in einem eigenen Header
    # (#190).
    log {
        output stdout
        format json
    }

    # Die Vorschau (Messsatz, Arbeitsspeicher, keine Geheimnisse). Das Praefix
    # wird abgeschnitten; die Seite ruft ihre API relativ und landet so bei der
    # Vorschau. Gleicher Ursprung wie die echte Oberflaeche — darum legt die
    # Seite ihren Schluessel je Pfad in ein eigenes Fach.
    redir /vorschau /vorschau/ 308
    handle_path /vorschau/* {
        reverse_proxy vorschau:8243
    }

    handle {
        reverse_proxy app:8000
    }
}
