# Umgebung für den Container bc1 auf BC0s Server (Vorlage, ohne Werte).
# Als .env.bc1 neben BC0s docker-compose.yml ablegen — NIE ins Repo.
# BC1_ZUGANG und BC1_COMPANY_ID stehen nicht hier, sondern in BC0s .env: beide Dienste
# lesen sie von dort, damit die Werte nie auseinanderlaufen.
# Geheimnisse in einfache Anführungszeichen setzen ('…'): ohne oder mit doppelten
# ersetzt Compose ein $ im Wert, und Leerzeichen am Rand fallen weg.

# Datenbank: Supabase als bc1_role über den Session-Pooler (Port 5432), in derselben
# Host-Form wie BC0s DATABASE_URL. Nicht der Transaction-Pooler (6543).
BC1_DB_DSN=

# Die Anfrage, die BC1 gerade bedient (Form A-JJJJ-NN).
# Je Testlauf eine neue Anfrage (betrieb/BETRIEB.md, „Ablauf je Testlauf“).
BC1_ANFRAGE_ID=

# BC0-Anwendungskonto: BC1 meldet 'im_interview' und zieht nach dem Abschluss das Gate nach.
# Im Betrieb nie BC1_BC0_MELDUNGEN=aus.
BC1_BC0_URL=https://bc0.perspektivwechsel.ai
BC1_BC0_KONTO_EMAIL=
BC1_BC0_KONTO_PASSWORT=

# KI: Gemini mit bezahltem Zugang; ein eigener Schlüssel nur für diesen Server.
BC1_LLM=gemini
GEMINI_API_KEY=
