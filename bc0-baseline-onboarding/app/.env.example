# ---- BC0 Onboarding-App · Konfiguration ----

# PostgreSQL/Supabase (Schema v1.1) — Projekt-Vorgabe.
# Supabase: Dashboard -> Connect -> Connection String (Session Pooler empfohlen).
# [PASSWORT] durch das DB-Passwort ersetzen. Leer/auskommentiert = SQLite-Fallback (bc0.db).
# DATABASE_URL=postgresql://postgres.PROJEKTREF:[PASSWORT]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Optional: abweichender SQLite-Pfad (nur ohne DATABASE_URL relevant)
# BC0_DB=./bc0.db

# ---- Deployment (Docker/Caddy, unverändert) ----
# DOMAIN=bc0.example.org
# ACME_EMAIL=admin@example.org

# ---- Beleg-Dokumente (Stufe 1) ----
# Ohne diese Variablen: Ablage lokal unter ./belege (Default).
# Mit Supabase Storage (EU): URL + Service-Role-Key aus Dashboard -> Settings -> API.
# SUPABASE_URL=https://PROJEKTREF.supabase.co
# SUPABASE_SERVICE_KEY=eyJ...
# SUPABASE_BUCKET=belege
# BELEGE_DIR=./belege
# MAX_DOC_MB=15

# ---- Ruf an BC2 (v3.1/v3.2) ----
# Ohne BC2_HOOK_URL wird nicht gerufen; das Paket steht trotzdem in der
# Datenbank und BC2 holt es ueber v_uebergabe_offen nach.
# BC2_HOOK_SECRET ist der HMAC-Schluessel, mit dem wir signieren und BC2
# prueft — derselbe Wert, den BC2 als BC2_TRIGGER_TOKEN fuehrt. Kommt per
# SMS, nie per Chat, Mail oder Repo.
# BC2_HOOK_URL=https://bc2.02da.de/api/bc0/uebergabe
# BC2_HOOK_SECRET=
# BC2_HOOK_TIMEOUT=5
