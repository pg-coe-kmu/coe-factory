    {
      "id": "647fef7a-d49e-4e45-b828-4511791876b1",
      "name": "Antwort",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        80
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Ergebnis für den Aufrufer, BC3-82 zeigt es an\nconst auftrag = $('Auftrag prüfen').first().json;\nif (auftrag.art === 'pfad') {\n  return [{ json: { art: 'pfad', geprueft_am: new Date().toISOString(), liste: [], neu: [], gestartet: [auftrag.pfad] } }];\n}\nconst e = $('Neue bestimmen').first().json;\nreturn [{ json: { ...e, gestartet: e.art === 'starten' ? e.neu : [] } }];\n"
      }
    },
    {
      "id": "183df170-9865-4e6c-90ea-8c29f8741d1b",
      "name": "Lieferungen auflisten",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        240
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.github.com/repos/pg-coe-kmu/coe-factory/git/trees/main?recursive=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "b3a2b606-d398-4973-928a-d0899b30585b",
      "name": "Ordner auswerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        144
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Lieferordner von BC2 mit ihren Konzepten, ein Eintrag je Ordner\nconst REPO = 'pg-coe-kmu/coe-factory';\nconst BASIS = 'contracts/bc2-to-bc3/lieferungen/';\nconst antwort = $input.first().json;\nif (antwort.truncated) throw new Error('Dateiliste von GitHub unvollständig (truncated)');\n\nconst ordner = {};\nfor (const t of antwort.tree || []) {\n  if (t.type !== 'blob' || !t.path.startsWith(BASIS)) continue;\n  const teile = t.path.slice(BASIS.length).split('/');\n  if (teile.length !== 2) continue;\n  const [name, datei] = teile;\n  ordner[name] ??= { ordner: name, konzepte: [], prio_pfad: null };\n  if (/^konzept_.+[.]json$/.test(datei)) ordner[name].konzepte.push(t.path);\n  if (datei === 'prozesspriorisierung.json') ordner[name].prio_pfad = t.path;\n}\n\nconst alle = Object.values(ordner).filter(o => o.konzepte.length);\nif (!alle.length) throw new Error('Keine Konzepte unter ' + BASIS);\nconst ohnePrio = alle.filter(o => !o.prio_pfad).map(o => o.ordner);\n\nreturn alle.filter(o => o.prio_pfad).map(o => ({\n  json: {\n    ...o,\n    prio_url: 'https://raw.githubusercontent.com/' + REPO + '/main/' + o.prio_pfad,\n    ohne_prio: ohnePrio,\n  },\n}));\n"
      }
    },
    {
      "id": "7ececdcd-1680-44e8-855b-131785c48255",
      "name": "Priorisierung holen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        144
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.prio_url }}",
        "options": {
