            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "24899e54-1edf-44c0-a0f0-7e6adefb8eb3",
      "name": "Bekannte Läufe holen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1344,
        144
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "select lauf_id, konzept_pfad, status, modus, gestartet_am from public.laeufe where konzept_pfad is not null",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "name": "Postgres BC3"
        }
      },
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "id": "7f8fbb57-733d-47a6-9f94-28a1d6e8bbea",
      "name": "Neue bestimmen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        144
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Was ist neu, was kennt BC3 schon? Abgebrochene Läufe zählen als bekannt\nconst auftrag = $('Auftrag prüfen').first().json;\nconst ordner = $('Ordner auswerten').all().map(i => i.json);\nconst prios = $('Priorisierung holen').all().map(i => i.json);\nconst norm = p => (String(p || '').match(/contracts[/]bc2-to-bc3[/].+[.]json/) || [null])[0];\nconst zeit = z => new Date(z.gestartet_am || 0).getTime() || 0;\n\nconst laeufe = {};\nfor (const z of $input.all().map(i => i.json)) {\n  const p = norm(z.konzept_pfad);\n  if (p && (!laeufe[p] || zeit(z) > zeit(laeufe[p]))) laeufe[p] = z;\n}\n\nconst liste = [];\nordner.forEach((o, i) => {\n  const prio = prios[i] || {};\n  const lesbar = !prio.error && prio.priorisierung_id;\n  const gate1 = lesbar ? (prio.gate1?.status || null) : null;\n  for (const pfad of o.konzepte) {\n    const lauf = laeufe[pfad];\n    let stand = 'neu';\n    if (lauf) stand = 'bekannt';\n    else if (!lesbar) stand = 'priorisierung_nicht_lesbar';\n    else if (!gate1) stand = 'ohne_gate1';\n    else if (gate1 !== 'approved') stand = 'nicht_freigegeben';\n    liste.push({\n      ordner: o.ordner,\n      pfad,\n      gate1,\n      gate1_am: lesbar ? (prio.gate1?.entschieden_am || null) : null,\n      uebergeben_am: lesbar ? (prio.uebergeben_am || prio.erzeugt_am || null) : null,\n      stand,\n      lauf_id: lauf?.lauf_id || null,\n      lauf_status: lauf?.status || null,\n    });\n  }\n});\nfor (const name of ordner[0]?.ohne_prio || []) {\n  liste.push({ ordner: name, pfad: null, gate1: null, stand: 'ohne_priorisierung' });\n}\n\nreturn [{\n  json: {\n    art: auftrag.art,\n    geprueft_am: new Date().toISOString(),\n    liste,\n    neu: liste.filter(l => l.stand === 'neu').map(l => l.pfad),\n  },\n}];\n"
      }
    },
