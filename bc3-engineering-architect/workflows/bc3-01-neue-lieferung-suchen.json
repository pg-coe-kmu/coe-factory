      "id": "0ec74ef7-4bd1-41de-9f50-5d09212447ca",
      "name": "Auftrag prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        176
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Zeitplan startet immer, Aufrufer sagen selbst, was sie wollen\nconst rein = $input.first().json;\nconst art = rein.art || 'starten';\nif (!['auflisten', 'starten'].includes(art)) throw new Error('Unbekannte Art: ' + art);\nconst pfad = String(rein.pfad || '').trim();\n\nreturn [{\n  json: {\n    art: pfad ? 'pfad' : art,\n    pfad,\n    gestartet_von: rein.gestartet_von || (rein.timestamp ? 'Zeitplan' : 'BC3-01'),\n    bemerkung: rein.bemerkung || '',\n  },\n}];\n"
      }
    },
